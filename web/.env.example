# Copy this file to .env and fill in your token for local development.
# In Vercel: Project Settings → Environment Variables → Add VITE_HF_TOKEN.
#
# The token is inlined at build time (Vite replaces import.meta.env.VITE_HF_TOKEN).
# BrutScript passes it to the HuggingFace Inference API for `model` blocks.
# Without it, model blocks compile and run but all inference calls return errors.

VITE_HF_TOKEN=hf_your_token_here
